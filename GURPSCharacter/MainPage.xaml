<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GURPSCharacter.MainPage"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="100" ColumnDefinitions="1000" HorizontalOptions="Center">
            <VerticalStackLayout    
                Padding="30,0"
                Spacing="25">
                <Image Grid.Row="0"
                    Source="gurps_logo.png"
                    BackgroundColor="Black"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    SemanticProperties.Description="GURPS logo" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
